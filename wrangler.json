{
  "compatibility_date": "2026-09-15",
  "main": "src/server/index.ts",
  "name": "hpws",
  "migrations": [
    {
      "new_sqlite_classes": [
        "Chat"
      ],
      "tag": "v1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "hpws-media"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Chat",
        "name": "Chat"
      }
    ]
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
